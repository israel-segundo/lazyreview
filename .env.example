# Copy to .env and fill in. .env is gitignored and read by `docker compose`.

# --- Host side -------------------------------------------------------------
# Host port the UI is forwarded to (http://127.0.0.1:3334 by default).
LAZYREVIEW_HOST_PORT=3334
# Host interface to publish on. 0.0.0.0 exposes the UI to your network (no auth!).
LAZYREVIEW_BIND=127.0.0.1
# Extra hostnames/IPs the UI answers to, comma-separated (localhost and 127.0.0.1
# always work). Needed with LAZYREVIEW_BIND=0.0.0.0, e.g. myhost.lan,192.168.1.20
# LAZYREVIEW_ALLOWED_HOSTS=
# Container user ids (build args). Only matters if you bind-mount host dirs.
LAZYREVIEW_UID=1000
LAZYREVIEW_GID=1000

# --- Credentials -----------------------------------------------------------
# Optional here: Settings → Credentials can store these (and overrides .env)
# or log the CLIs in through the browser.
# GitHub: PR sync, clones and posting. `gh auth token` prints yours.
GH_TOKEN=

# Claude: set one. CLAUDE_CODE_OAUTH_TOKEN comes from `claude setup-token`
# (uses your subscription); ANTHROPIC_API_KEY bills the API.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Cursor `agent` CLI: API key from the Cursor dashboard.
CURSOR_API_KEY=

# Agy: Gemini API key from Google AI Studio. lazyreview sets
# modelProvider=gemini for agy while this is present.
# GEMINI_API_KEY=
