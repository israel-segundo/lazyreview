[Unit]
Description=lazyreview — agentic code review daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# install.sh rewrites ExecStart bind from ~/.config/lazyreview/config.toml
ExecStart=%h/.local/share/lazyreview/venv/bin/gunicorn lazyreview.main:app \
  --worker-class uvicorn.workers.UvicornWorker \
  --workers 1 \
  --bind 127.0.0.1:3334 \
  --timeout 120
Restart=on-failure
RestartSec=3
Environment=LAZYREVIEW_CONFIG=%h/.config/lazyreview/config.toml
# User CLIs (agent, claude, agy) live under ~/.local/bin; systemd's default PATH omits it.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

# Single worker: in-process job runner + sqlite
# Do not raise workers above 1 without an external job queue.

[Install]
WantedBy=default.target
